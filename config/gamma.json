{
  "$comment": "FinanceModel configuration for gamma. Settings, defaults and SSM parameter NAMES only; never account IDs, ARNs, bucket, role or endpoint values, prices or secrets. Live values (instance prices, auto-approve threshold, lease limits, research storage reference) are read at run time from /finplan/gamma/financemodel/config/*. Defaults are configuration pending user review (design D3, D4, D7; FM-OQ-3, FM-OQ-5).",
  "environment": "gamma",
  "region": "us-east-2",
  "phase": 1,
  "served_contract_majors": [
    1
  ],
  "instrument": {
    "$comment": "Initial instrument (design D6): S&P 500 exposure through a tracking ETF daily series; distinct from the index level and the constituent universe. data_source 'platform_snapshots' = this environment's platform serves approved real (phase 2, yfinance) snapshots; identical in beta, gamma and prod (data parity, user decision 26). Fixture-mode preparation still accepts synthetic snapshots, so prod also runs on still-synthetic snapshots during the phase 2 transition.",
    "ticker": "SPY",
    "dataset_kind": "etf-daily",
    "granularity": "daily",
    "calendar": "XNYS",
    "currency": "USD",
    "data_source": "platform_snapshots"
  },
  "job_types": {
    "prepare_dataset": {
      "entry_point": "prepare_dataset",
      "compute_class": "cpu",
      "default_runtime_seconds": 600,
      "max_runtime_seconds": 1800,
      "instance_types": [
        "ml.m5.xlarge"
      ],
      "default_instance_type": "ml.m5.xlarge",
      "max_instance_count": 1,
      "budget_category": "cpu_research",
      "deployed": true
    },
    "run_backtest": {
      "entry_point": "run_backtest",
      "compute_class": "cpu",
      "default_runtime_seconds": 900,
      "max_runtime_seconds": 1800,
      "instance_types": [
        "ml.m5.xlarge"
      ],
      "default_instance_type": "ml.m5.xlarge",
      "max_instance_count": 1,
      "budget_category": "cpu_research",
      "deployed": true
    },
    "run_benchmark": {
      "entry_point": "run_benchmark",
      "compute_class": "cpu",
      "default_runtime_seconds": 1200,
      "max_runtime_seconds": 1800,
      "instance_types": [
        "ml.m5.xlarge"
      ],
      "default_instance_type": "ml.m5.xlarge",
      "max_instance_count": 1,
      "budget_category": "cpu_research",
      "deployed": true
    },
    "report": {
      "entry_point": "report",
      "compute_class": "cpu",
      "default_runtime_seconds": 300,
      "max_runtime_seconds": 900,
      "instance_types": [
        "ml.m5.xlarge"
      ],
      "default_instance_type": "ml.m5.xlarge",
      "max_instance_count": 1,
      "budget_category": "cpu_research",
      "deployed": true
    },
    "daily_recommendation": {
      "$comment": "Platform-triggered production candidate (change add-daily-recommendation-and-on-demand-experiments): only the FinancialPlanning daily trigger role submits it, it runs exactly the strategy in config/production-strategy, one ml.m5.xlarge with a 30 minute hard cap. auto_approve_usd is this kind's own approval ceiling (the user's gate is publication, not compute); cost_cap_usd and cost_check_usd_per_hour feed the build cost check (DRJ-05): cost_check_usd_per_hour is a deliberately high planning bound, not a live price (live prices come only from config/instance-prices).",
      "entry_point": "daily_recommendation",
      "compute_class": "cpu",
      "default_runtime_seconds": 1800,
      "max_runtime_seconds": 1800,
      "instance_types": [
        "ml.m5.xlarge"
      ],
      "default_instance_type": "ml.m5.xlarge",
      "max_instance_count": 1,
      "budget_category": "cpu_research",
      "deployed": true,
      "auto_approve_usd": 0.15,
      "cost_cap_usd": 0.15,
      "cost_check_usd_per_hour": 0.28
    },
    "model_selection": {
      "$comment": "Offline model selection on request only (decision 27; change add-learning-and-llm-strategies): controls, traditional optimizers (min_variance, mean_variance, scenario_cvar) and RL (ppo, sac x 5 seeds) on one approved research-universe snapshot, through the common evaluator; train 2025, validate 2026H1, untouched test 2026-07-01..latest, evaluated once. One CPU SageMaker TRAINING job (RL learners never run in Lambda or CodeBuild). cost_check_usd_per_hour is a deliberately high planning bound for the build check (live prices come only from config/instance-prices); at about USD 0.23/h the upper-bound estimate for 3000 s is about USD 0.20, under the beta/gamma auto-approve threshold (USD 0.25, decision 24); prod always asks the approver. The protocol is configuration pending user review, frozen into every run at submission.",
      "entry_point": "model_selection",
      "compute_class": "cpu",
      "sagemaker_job": "training",
      "default_runtime_seconds": 3000,
      "max_runtime_seconds": 3000,
      "instance_types": [
        "ml.m5.xlarge"
      ],
      "default_instance_type": "ml.m5.xlarge",
      "max_instance_count": 1,
      "budget_category": "cpu_research",
      "deployed": true,
      "cost_cap_usd": 0.25,
      "cost_check_usd_per_hour": 0.28,
      "protocol": {
        "protocol_version": "finplan-model-selection/1",
        "data_start": "2025-01-01",
        "splits": {
          "train": {
            "start": "2025-01-01",
            "end": "2025-12-31"
          },
          "validation": {
            "start": "2026-01-01",
            "end": "2026-06-30"
          },
          "test": {
            "start": "2026-07-01",
            "end": null
          }
        },
        "selection": {
          "metric": "sharpe",
          "split": "validation"
        },
        "traditional": {
          "min_variance": {
            "grid": {
              "lookback": [
                20,
                60,
                120
              ]
            },
            "fixed": {}
          },
          "mean_variance": {
            "grid": {
              "lookback": [
                20,
                60,
                120
              ],
              "risk_aversion": [
                1.0,
                5.0,
                20.0
              ]
            },
            "fixed": {}
          },
          "scenario_cvar": {
            "grid": {
              "lookback": [
                60,
                120
              ],
              "alpha": [
                0.9,
                0.95
              ]
            },
            "fixed": {
              "n_scenarios": 500,
              "scenario_method": "bootstrap",
              "seed": 0
            }
          }
        },
        "rl": {
          "algorithms": [
            "ppo",
            "sac"
          ],
          "seeds": [
            0,
            1,
            2,
            3,
            4
          ],
          "env": {
            "window": 20,
            "return_scale": 50.0,
            "obs_clip": 5.0,
            "action_scale": 5.0,
            "step_sessions": 1,
            "decision_frequency": "daily",
            "reward": {
              "risk_penalty": 1.0,
              "drawdown_penalty": 0.5,
              "turnover_penalty": 0.0,
              "reward_scale": 100.0
            }
          },
          "grid": {
            "risk_penalty": [
              0.5,
              2.0
            ]
          },
          "ppo": {
            "total_timesteps": 30000,
            "learning_rate": 0.0003,
            "n_steps": 256,
            "batch_size": 64,
            "n_epochs": 10,
            "gamma": 0.99,
            "gae_lambda": 0.95,
            "clip_range": 0.2,
            "ent_coef": 0.0,
            "net_arch": [
              64,
              64
            ],
            "eval_every": 2048,
            "patience": 5
          },
          "sac": {
            "total_timesteps": 8000,
            "learning_rate": 0.0003,
            "buffer_size": 50000,
            "learning_starts": 500,
            "batch_size": 128,
            "tau": 0.005,
            "gamma": 0.99,
            "train_freq": 1,
            "gradient_steps": 1,
            "net_arch": [
              64,
              64
            ],
            "eval_every": 1000,
            "patience": 4
          }
        },
        "runtime": {
          "reserve_seconds": 600
        },
        "incumbent_fallback": "buy_and_hold"
      }
    }
  },
  "lease": {
    "max_holders": {
      "cpu": 1,
      "gpu": 0
    },
    "ttl_seconds": 900,
    "heartbeat_seconds": 120
  },
  "queue": {
    "max_depth": 10,
    "quota_backoff_initial_seconds": 60,
    "quota_backoff_max_seconds": 900,
    "quota_max_wait_seconds": 3600,
    "start_retry_limit": 2
  },
  "approval": {
    "auto_approve_usd_default": 0,
    "approval_window_hours": 72
  },
  "cost": {
    "price_max_age_days": 30,
    "storage_estimate_usd": 0.01
  },
  "idempotency": {
    "retention_days": 8
  },
  "retention": {
    "scratch_days": 30,
    "noncurrent_version_days": 7,
    "incomplete_multipart_days": 1
  },
  "simulation_defaults": {
    "$comment": "Simulator conventions (design D7). Every value is configuration pending user review (FM-OQ-5), not a market fact. Documented in docs/simulator.md.",
    "venue": "paper",
    "execution_timing": "next_open",
    "rebalance_frequency": "monthly",
    "initial_cash": 100000.0,
    "base_currency": "USD",
    "cash_rate_annual": 0.0,
    "periods_per_year": 252,
    "fees": {
      "proportional_bps": 1.0,
      "fixed_per_trade": 0.0
    },
    "spread": {
      "half_spread_bps": 1.0
    },
    "slippage": {
      "model": "linear_participation",
      "coefficient_bps": 10.0
    },
    "liquidity": {
      "participation_cap": 0.05,
      "unfilled": "cancel"
    },
    "constraints": {
      "long_only": true,
      "min_weight": 0.0,
      "max_weight": 1.0,
      "min_cash": 0.0,
      "max_cash": 1.0,
      "max_turnover": null
    },
    "constraint_policy": "project",
    "infeasible_fallback": "hold_current",
    "reconciliation_tolerance": 1e-06,
    "weight_tolerance": 1e-09
  }
}
